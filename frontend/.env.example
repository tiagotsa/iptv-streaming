# Variáveis de ambiente para o projeto IPTV Frontend
# Copie este arquivo para .env.local para desenvolvimento local

# URL da API backend
VITE_API_URL=https://iptv-streaming-production.up.railway.app/api

# Para desenvolvimento local, você pode usar:
# VITE_API_URL=http://localhost:3000/api

# Outras variáveis que podem ser necessárias no futuro:
# VITE_APP_NAME=IPTV Premium
# VITE_APP_VERSION=1.0.0
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X